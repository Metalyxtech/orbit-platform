# Local development. Copy to .env.local (never commit it).
# On Amplify these are set in App settings > Environment variables (non-secret only).
HOSTING=amplify
APP_STAGE=local
APP_AWS_REGION=ap-southeast-1
APP_BASE_URL=http://localhost:3000
APP_S3_BUCKET=orbit-dev-files-apse1-<account-id>
APP_SQS_EVENTS_URL=
APP_SCHEDULER_GROUP=orbit-dev-timers
APP_SCHEDULER_TARGET_ARN=
APP_SCHEDULER_ROLE_ARN=
APP_SCHEDULER_DLQ_ARN=
APP_SES_TOPIC_ARN=
NEXT_PUBLIC_WORKOS_CLIENT_ID=client_xxx

# Local only: sign in as any seeded user without WorkOS
APP_AUTH_MODE=dev

# Local only: read secrets from env instead of SSM
APP_SECRETS_FROM_ENV=1
SECRET_NEON_TENANT_URL=postgres://app_user:...@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SECRET_NEON_CONTROL_URL=postgres://app_user:...@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SECRET_WORKOS_API_KEY=sk_test_xxx
SECRET_WORKOS_COOKIE_PASSWORD=at-least-32-characters-long-random-string
SECRET_TIMER_HMAC_SECRET=another-long-random-string
