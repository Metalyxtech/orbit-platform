{
  "name": "orbit-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @orbit/db generate",
    "db:migrate": "pnpm --filter @orbit/db migrate",
    "db:seed": "pnpm --filter @orbit/db seed",
    "cdk": "pnpm --filter @orbit/infra cdk"
  },
  "devDependencies": {
    "next": "15.5.28",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "react": "19.1.10",
      "react-dom": "19.1.10",
      "@types/react": "19.1.17",
      "@types/react-dom": "19.1.11"
    }
  }
}
